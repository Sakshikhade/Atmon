# ---------------------------------------------------------------------------
# AAMAS Local Edge Monitor — Configuration Template
# ---------------------------------------------------------------------------

# Camera & Video Source (device index integer or path to video file)
CAMERA_INDEX=0

# Webhook endpoint for local/remote alert notifications (e.g. mock_server.py)
WEBHOOK_URL=http://localhost:5001/webhook

# Mobile SMS notifications via Twilio (optional)
ENABLE_MOBILE_NOTIFICATIONS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TARGET_CAREGIVER_MOBILE=

# Local Logging & Storage Settings
LOG_LEVEL=INFO
DATA_LOG_PATH=data/behavior_log.csv
DB_PATH=data/outbox.db

# Postgres (Supabase direct connection). SSL is required.
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=postgres
DB_PASSWORD=
