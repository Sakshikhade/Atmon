cache/

# Recorded footage. Nothing containing video of the subject is tracked --
# reference clips included. They are the system's source of truth, so keep
# your own backup: losing them means re-recording.
data/videos/
data/references/
data/events/
data/clips/
*.dets.json
*.mov

*.pem
dev-Juno.pem
